{
  "appId": "com.tavernhost.clientmodmanager",
  "productName": "SF Mod Manager",
  "directories": {
    "output": "release"
  },
  "extraMetadata": {
    "name": "tavern-client-mod-manager",
    "productName": "SF Mod Manager",
    "version": "0.7.0",
    "main": "companion/main.js"
  },
  "files": [
    "companion/**",
    "dist/valheim-mods.js",
    "dist/zip.js",
    "dist/modscan.js",
    "dist/nexus.js",
    "dist/bepinex-config.js",
    "dist/platform/**",
    "dist/modsync/**",
    "package.json"
  ],
  "asar": false,
  "win": {
    "target": "nsis",
    "icon": "companion/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SF Mod Manager",
    "runAfterFinish": true,
    "installerIcon": "companion/icon.ico",
    "uninstallerIcon": "companion/icon.ico",
    "license": "LICENSE",
    "artifactName": "SF-Mod-Manager-Setup-${version}.exe"
  },
  "publish": null,
  "linux": {
    "target": [
      "AppImage",
      "deb",
      "rpm"
    ],
    "icon": "companion/icon.png",
    "executableName": "sf-mod-manager",
    "category": "Game",
    "maintainer": "CorruptedVariant <75761168+Volatile111@users.noreply.github.com>",
    "artifactName": "SF-Mod-Manager-${version}-${arch}.${ext}",
    "synopsis": "Keeps your mods matched to your game servers"
  },
  "rpm": {
    "fpm": [
      "--rpm-rpmbuild-define",
      "_build_id_links none"
    ]
  }
}
