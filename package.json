{
  "name": "tavern-host",
  "productName": "Server Forge",
  "version": "0.12.1",
  "description": "Server Forge: a control panel for hosting and managing game servers.",
  "author": "CorruptedVariant",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "desktop": "electron desktop",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "snapshot": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/snapshot-source.ps1",
    "api-docs": "node tools/make-api-docs.mjs",
    "dist": "npm run api-docs && npm run snapshot && tsc -p tsconfig.build.json && electron-builder --win nsis && node tools/forge-release-assets.mjs host",
    "client": "tsc -p tsconfig.build.json && electron companion",
    "dist:client": "npm run snapshot && tsc -p tsconfig.build.json && electron-builder --config companion/builder.json --win nsis && node tools/forge-release-assets.mjs client",
    "release": "npm run dist && node tools/publish-release.mjs host",
    "release:client": "npm run dist:client && node tools/publish-release.mjs client",
    "dist:linux": "tsc -p tsconfig.build.json && electron-builder --linux AppImage deb rpm --x64",
    "dist:client:linux": "tsc -p tsconfig.build.json && electron-builder --config companion/builder.json --linux AppImage deb rpm --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.gameserverpanel.app",
    "productName": "Server Forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "public/**",
      "scripts/**",
      "desktop/**",
      "package.json",
      "CHANGELOG.md"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Server Forge",
      "runAfterFinish": true,
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "desktop/installer.nsh",
      "license": "LICENSE",
      "artifactName": "Server-Forge-Setup-${version}.exe"
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "desktop/icon.png",
      "executableName": "server-forge",
      "category": "Game",
      "maintainer": "CorruptedVariant <75761168+Volatile111@users.noreply.github.com>",
      "artifactName": "Server-Forge-${version}-${arch}.${ext}",
      "synopsis": "A control panel for hosting and managing game servers"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    }
  },
  "homepage": "https://github.com/CorruptedVariant/server-forge"
}
